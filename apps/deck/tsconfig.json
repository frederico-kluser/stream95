{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] },
    // The Motion UI sources under src/components/motion-ui are owned by the shadcn CLI (each
    // `shadcn add` overwrites them) and are not written for noUncheckedIndexedAccess.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "test", "motion.theme.ts"]
}
