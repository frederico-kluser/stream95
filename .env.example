# stream95 — copie para .env (que NUNCA vai para o git) e preencha o que for usar.
# Tudo é opcional: sem chaves o overlay funciona com chat ao vivo + filtros locais.

# --- Servidor local -------------------------------------------------------
# Porta do servidor (API + WebSocket + overlays). 1995, o ano do Windows 95.
PORT=1995
# Só aceita conexões desta máquina (recomendado). Use 0.0.0.0 para outra máquina na rede.
HOST=127.0.0.1

# --- Twitch ---------------------------------------------------------------
# Canal lido pelo chat (leitura anônima, sem login).
TWITCH_CHANNEL=frederico_kluser
# Opcional: Client ID de um app "Public" em https://dev.twitch.tv/console/apps
# Habilita alertas reais (follow/sub/raid/bits/resgates) via EventSub e respostas
# do Clippy no chat. Depois rode: npm run twitch:login
TWITCH_CLIENT_ID=

# --- OpenRouter (moderação por IA, voz e Clippy) ---------------------------
# https://openrouter.ai/keys — defina um limite de crédito na chave.
OPENROUTER_API_KEY=
# Modelos (ids do OpenRouter). Os padrões foram escolhidos por benchmark em PT-BR (docs/moderation-benchmark.md).
MODERATION_MODEL=google/gemini-2.5-flash-lite
MODERATION_FALLBACK_MODEL=mistralai/ministral-8b-2512
ASSISTANT_MODEL=openai/gpt-4.1-mini
ASSISTANT_FALLBACK_MODEL=google/gemini-2.5-flash-lite
TTS_MODEL=elevenlabs/eleven-flash-v2.5

# --- GitHub (feed de commits ao vivo) --------------------------------------
GITHUB_USER=frederico-kluser
# Opcional: token só-leitura para subir o limite da API de 60 para 5000 req/h.
GITHUB_TOKEN=

# --- OBS (trocar de cena pelo painel) --------------------------------------
# Ative em OBS > Ferramentas > Configurações do servidor WebSocket.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
